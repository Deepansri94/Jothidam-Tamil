{
  "name": "jothidam-tamil",
  "version": "1.0.0",
  "description": "Jothidam Tamil — Complete Tamil Astrology Desktop App",
  "main": "main.js",
  "author": "Deepansri94",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.jothidam.tamil",
    "productName": "Jothidam Tamil",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jothidam Tamil"
    },
    "files": [
      "**/*",
      "!.git/**"
    ]
  },
  "devDependencies": {
    "electron": "^36.9.5",
    "electron-builder": "^26.0.12"
  }
}
